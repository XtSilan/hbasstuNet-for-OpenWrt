#!/bin/sh
set -u

SECTION=main
[ "$#" -eq 0 ] || SECTION="$1"
case "$SECTION" in
    *[!A-Za-z0-9_]*|'')
        logger -t hbasstunet -p daemon.err -- "无效的认证实例名称"
        exit 1
        ;;
esac

TAG="hbasstunet.$SECTION"
BASE="/var/run/hbasstunet/$SECTION"
COOKIE="$BASE/cookie"
CSRF_FILE="$BASE/csrf"
ISP_FILE="$BASE/isp"
SESSION_FILE="$BASE/session_id"
STATUS_FILE="$BASE/status"
ROUTE_STATE_FILE="$BASE/route_policy"
IDENTITY_LOCK=
ACTIVE=0
OWNED=0
DEVICE=
IP=
MAC=
RESPONSE_SESSION=
OPERATOR=
DIAL_CODE=
LAST_MESSAGE=''
ROUTE_TABLE=
ROUTE_RULE_PREF=
OWN_ROUTE_TABLE=0
GATEWAY=
ROUTE_GATEWAY=

get() { uci -q get "hbasstunet.$SECTION.$1" 2>/dev/null || true; }
log() { logger -t "$TAG" -- "$*"; }
err() { logger -t "$TAG" -p daemon.err -- "$*"; }
portal() { get portal_url | sed 's#/$##'; }
normalize_mac() { printf %s "$1" | tr 'A-Z' 'a-z' | tr -d ':-'; }
normalize_user() { printf %s "$1" | tr 'A-Z' 'a-z'; }

write_status() {
    local message
    message=$(printf %s "$LAST_MESSAGE" | tr '\r\n' '  ')
    printf 'state=%s\ninterface=%s\ndevice=%s\nipv4=%s\nmac=%s\noperator=%s\ndial_code=%s\nmessage=%s\n' \
        "$1" "$(get interface)" "$DEVICE" "$IP" "$MAC" "$OPERATOR" "$DIAL_CODE" "$message" > "$STATUS_FILE"
    chmod 600 "$STATUS_FILE"
}

reset_local() {
    local state="$1"
    ACTIVE=0
    OWNED=0
    OPERATOR=
    DIAL_CODE=
    [ "$#" -ge 2 ] && LAST_MESSAGE="$2"
    rm -f "$COOKIE" "$CSRF_FILE" "$ISP_FILE" "$SESSION_FILE" "$BASE/csrf.json"
    write_status "$state"
}

route_rule_pref() {
    local seed candidate attempt=0
    seed=$(awk -v section="$SECTION" 'BEGIN {
        alphabet = "_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
        value = 0
        for (i = 1; i <= length(section); i++)
            value = (value * 33 + index(alphabet, substr(section, i, 1))) % 2147483647
        print value
    }')
    candidate=$((1100 + seed % 800))
    while [ "$attempt" -lt 800 ]; do
        if ! ip -4 rule show 2>/dev/null | grep -q "^$candidate:" \
            && ! ip -4 route show table $((10000 + candidate)) 2>/dev/null | grep -q .; then
            printf '%s' "$candidate"
            return 0
        fi
        candidate=$((1100 + (candidate - 1099) % 800))
        attempt=$((attempt + 1))
    done
    return 1
}

policy_rule_exists() {
    ip -4 rule show 2>/dev/null | awk -v pref="$1:" -v source="$2" -v table="$3" '
        $1 == pref && $2 == "from" && ($3 == source || $3 == source "/32") && $4 == "lookup" && $5 == table { found = 1 }
        END { exit !found }'
}

policy_rule_delete() {
    ip -4 rule del pref "$1" from "$2/32" lookup "$3" 2>/dev/null \
        || ip -4 rule del pref "$1" from "$2" lookup "$3" 2>/dev/null \
        || true
}

policy_state_write() {
    printf 'pid=%s\npref=%s\ntable=%s\nsource=%s\nowned=%s\n' \
        "$$" "$ROUTE_RULE_PREF" "$ROUTE_TABLE" "$IP" "$OWN_ROUTE_TABLE" > "$ROUTE_STATE_FILE"
    chmod 600 "$ROUTE_STATE_FILE"
}

stale_policy_clear() {
    local old_pid old_pref old_table old_source old_owned
    [ -s "$ROUTE_STATE_FILE" ] || return 0
    old_pid=$(sed -n 's/^pid=//p' "$ROUTE_STATE_FILE" | head -n 1)
    old_pref=$(sed -n 's/^pref=//p' "$ROUTE_STATE_FILE" | head -n 1)
    old_table=$(sed -n 's/^table=//p' "$ROUTE_STATE_FILE" | head -n 1)
    old_source=$(sed -n 's/^source=//p' "$ROUTE_STATE_FILE" | head -n 1)
    old_owned=$(sed -n 's/^owned=//p' "$ROUTE_STATE_FILE" | head -n 1)
    if [ -n "$old_pid" ] && [ "$old_pid" != "$$" ] && kill -0 "$old_pid" 2>/dev/null; then
        case "$(tr '\000' ' ' < "/proc/$old_pid/cmdline" 2>/dev/null || true)" in
            *"/usr/sbin/hbasstunet $SECTION "*)
                err "认证实例已在运行 pid=$old_pid"
                return 1
                ;;
        esac
    fi
    if [ -n "$old_pref" ] && [ -n "$old_source" ] && [ -n "$old_table" ] \
        && policy_rule_exists "$old_pref" "$old_source" "$old_table"; then
        policy_rule_delete "$old_pref" "$old_source" "$old_table"
    fi
    case "$old_owned:$old_table" in
        1:11[1-8][0-9][0-9]) ip -4 route flush table "$old_table" 2>/dev/null || true ;;
    esac
    rm -f "$ROUTE_STATE_FILE"
}

policy_route_clear() {
    if [ -n "$ROUTE_RULE_PREF" ] && policy_rule_exists "$ROUTE_RULE_PREF" "$IP" "$ROUTE_TABLE"; then
        policy_rule_delete "$ROUTE_RULE_PREF" "$IP" "$ROUTE_TABLE"
    fi
    if [ "$OWN_ROUTE_TABLE" -eq 1 ] && [ -n "$ROUTE_TABLE" ]; then
        ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null || true
    fi
    ROUTE_TABLE=
    ROUTE_RULE_PREF=
    OWN_ROUTE_TABLE=0
    ROUTE_GATEWAY=
    rm -f "$ROUTE_STATE_FILE"
}

table_has_default() {
    ip -4 route show table "$1" 2>/dev/null | awk -v dev="$DEVICE" '$1 == "default" { for (i = 1; i <= NF; i++) if ($i == "dev" && $(i + 1) == dev) { found = 1 } } END { exit !found }'
}

find_route_table() {
    local table candidate
    candidate=$(ip -4 rule show 2>/dev/null | awk -v dev="$DEVICE" '{ for (i = 1; i <= NF; i++) if ($i == "iif" && $(i + 1) == dev) { for (j = i + 2; j <= NF; j++) if ($j == "lookup" && $(j + 1) ~ /^[0-9]+$/) { print $(j + 1); exit } } }' | head -n 1)
    [ -z "$candidate" ] || ! table_has_default "$candidate" || table=$candidate
    [ -n "$table" ] || table=$(ip -4 route show table all 2>/dev/null | awk -v dev="$DEVICE" '$1 == "default" && $0 ~ ("dev " dev) { for (i = 1; i <= NF; i++) if ($i == "table" && $(i + 1) ~ /^[0-9]+$/) { print $(i + 1); exit } }')
    printf '%s' "$table"
}

policy_route_setup() {
    local table owned=0
    [ -n "$IP" ] && [ -n "$DEVICE" ] || return 1
    if [ "$OWN_ROUTE_TABLE" -eq 1 ] && [ -n "$ROUTE_TABLE" ]; then
        table=$ROUTE_TABLE
        owned=1
        table_has_default "$table" || ROUTE_GATEWAY=
    else
        table=$(find_route_table)
    fi
    if [ -z "$table" ]; then
        [ -n "$GATEWAY" ] || return 1
        [ -n "$ROUTE_RULE_PREF" ] || ROUTE_RULE_PREF=$(route_rule_pref) || return 1
        table=$((10000 + ROUTE_RULE_PREF))
        owned=1
    fi
    if [ -n "$ROUTE_TABLE" ] && [ "$ROUTE_TABLE" != "$table" ]; then
        policy_route_clear
    elif [ "$ROUTE_TABLE" = "$table" ]; then
        owned=$OWN_ROUTE_TABLE
    fi
    ROUTE_TABLE=$table
    OWN_ROUTE_TABLE=$owned
    if [ "$OWN_ROUTE_TABLE" -eq 1 ] && [ "$ROUTE_GATEWAY" != "$GATEWAY" ]; then
        [ -n "$GATEWAY" ] || return 1
        ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null || true
        ip -4 route replace table "$ROUTE_TABLE" "$GATEWAY/32" dev "$DEVICE" scope link src "$IP" 2>/dev/null || return 1
        if ! ip -4 route replace table "$ROUTE_TABLE" default via "$GATEWAY" dev "$DEVICE" src "$IP" 2>/dev/null; then
            ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null || true
            return 1
        fi
        ROUTE_GATEWAY=$GATEWAY
    fi
    [ -n "$ROUTE_RULE_PREF" ] || ROUTE_RULE_PREF=$(route_rule_pref) || return 1
    if policy_rule_exists "$ROUTE_RULE_PREF" "$IP" "$ROUTE_TABLE"; then
        policy_state_write
        return 0
    fi
    if ! ip -4 rule add pref "$ROUTE_RULE_PREF" from "$IP/32" lookup "$ROUTE_TABLE" 2>/dev/null; then
        if [ "$OWN_ROUTE_TABLE" -eq 1 ]; then
            ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null || true
            ROUTE_GATEWAY=
        fi
        return 1
    fi
    policy_state_write
}

release_identity_lock() {
    [ -n "$IDENTITY_LOCK" ] || return 0
    rm -f "$IDENTITY_LOCK/pid"
    rmdir "$IDENTITY_LOCK" 2>/dev/null || true
    IDENTITY_LOCK=
}

claim_identity() {
    local key lock_root next_lock owner
    key=$(normalize_mac "$MAC")
    [ -n "$key" ] || return 1
    lock_root=/var/run/hbasstunet/identities
    next_lock="$lock_root/$key"
    [ "$IDENTITY_LOCK" = "$next_lock" ] && return 0
    release_identity_lock
    mkdir -p "$lock_root"
    if ! mkdir "$next_lock" 2>/dev/null; then
        owner=$(cat "$next_lock/pid" 2>/dev/null || true)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -f "$next_lock/pid"
            rmdir "$next_lock" 2>/dev/null || return 1
            mkdir "$next_lock" 2>/dev/null || return 1
        else
            err "网络身份已被另一认证实例占用 mac=$MAC"
            return 1
        fi
    fi
    printf '%s\n' "$$" > "$next_lock/pid"
    IDENTITY_LOCK=$next_lock
}

network_info() {
    local name json next_device next_ip next_mac next_gateway identity_changed=0
    name=$(get interface)
    [ -n "$name" ] || name=wan
    json=$(ubus call "network.interface.$name" status 2>/dev/null || true)
    next_device=$(printf %s "$json" | jsonfilter -e '@.l3_device' 2>/dev/null || true)
    next_ip=$(printf %s "$json" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null || true)
    next_gateway=$(printf %s "$json" | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop' 2>/dev/null | head -n 1 || true)
    [ -n "$next_gateway" ] || next_gateway=$(printf %s "$json" | jsonfilter -e '@.route[0].nexthop' 2>/dev/null || true)
    [ -n "$next_gateway" ] || next_gateway=$(ip -4 route show default dev "$next_device" 2>/dev/null | awk '/via/ { print $3; exit }')
    [ -n "$next_device" ] && [ -n "$next_ip" ] || return 1
    next_mac=$(cat "/sys/class/net/$next_device/address" 2>/dev/null || true)
    [ -n "$next_mac" ] || return 1

    [ -n "$IP" ] && [ "$IP" != "$next_ip" ] && identity_changed=1
    [ -n "$DEVICE" ] && [ "$DEVICE" != "$next_device" ] && identity_changed=1
    [ -n "$MAC" ] && [ "$(normalize_mac "$MAC")" != "$(normalize_mac "$next_mac")" ] && identity_changed=1
    if [ "$identity_changed" -eq 1 ]; then
        policy_route_clear
    fi
    if [ "$OWNED" -eq 1 ] && [ "$identity_changed" -eq 1 ]; then
        log '接口身份已变化，丢弃旧会话状态并重新认证'
        DEVICE=$next_device
        IP=$next_ip
        MAC=$next_mac
        reset_local waiting
    else
        DEVICE=$next_device
        IP=$next_ip
        MAC=$next_mac
    fi
    GATEWAY=$next_gateway
}

curl_bound() {
    local timeout="$1"
    shift
    # Bind the Portal socket to this account's current source IPv4. On some
    # campus networks both WANs share a gateway/subnet and SO_BINDTODEVICE
    # returns ENETUNREACH even though source-address routing works correctly.
    curl -sS --interface "$IP" --connect-timeout 5 --max-time "$timeout" "$@"
}

identity_matches() {
    local body="$1" expected_user actual_user actual_ip actual_mac actual_session
    expected_user=$(get username)
    actual_user=$(printf %s "$body" | jsonfilter -e '@.online.Username' 2>/dev/null || true)
    actual_ip=$(printf %s "$body" | jsonfilter -e '@.online.UserIpv4' 2>/dev/null || true)
    actual_mac=$(printf %s "$body" | jsonfilter -e '@.online.UserMac' 2>/dev/null || true)
    actual_session=$(printf %s "$body" | jsonfilter -e '@.online.SessionId' 2>/dev/null || true)
    [ -n "$actual_user" ] && [ "$(normalize_user "$actual_user")" = "$(normalize_user "$expected_user")" ] || return 1
    [ "$actual_ip" = "$IP" ] || return 1
    [ -n "$actual_mac" ] && [ "$(normalize_mac "$actual_mac")" = "$(normalize_mac "$MAC")" ] || return 1
    [ -n "$actual_session" ] || return 1
    RESPONSE_SESSION=$actual_session
}

logout() {
    local isp csrf
    if [ "$OWNED" -ne 1 ] || [ ! -s "$COOKIE" ]; then
        reset_local stopped '认证实例已停止'
        return 0
    fi
    isp=$(cat "$ISP_FILE" 2>/dev/null || true)
    csrf=$(cat "$CSRF_FILE" 2>/dev/null || true)
    curl_bound 10 -b "$COOKIE" -H "X-CSRF-Token: $csrf" -H 'X-Requested-With: XMLHttpRequest' \
        -o /dev/null "$(portal)/api/account/logout?nasId=$(get nas_id)&userIpv4=$IP&userMac=$MAC&username=$(get username)&isp=$isp" || true
    reset_local stopped '已注销校园网会话'
}

cleanup() {
    logout
    policy_route_clear
    release_identity_lock
    rm -rf "$BASE"
}
response_message() {
    local body="$1" message
    for field in message msg dialMsg authMsg; do
        message=$(printf %s "$body" | jsonfilter -e "@.$field" 2>/dev/null || true)
        [ -z "$message" ] || { printf %s "$message"; return 0; }
    done
    return 1
}

authenticate() {
    local url csrf body code auth dial msg isp
    url=$(portal)
    [ -n "$url" ] || { err '门户地址为空'; reset_local error '门户地址为空'; return 1; }
    [ -n "$(get username)" ] && [ -n "$(get password)" ] || { err '账号或密码为空'; reset_local error '账号或密码为空'; return 1; }
    reset_local authenticating '正在连接校园网门户'

    curl_bound 10 -c "$COOKIE" -o "$BASE/csrf.json" "$url/api/csrf-token" || { err '获取 CSRF token 失败'; reset_local error '获取 CSRF token 失败'; return 1; }
    csrf=$(jsonfilter -i "$BASE/csrf.json" -e '@.csrf_token' 2>/dev/null || true)
    [ -n "$csrf" ] || { err 'CSRF token 为空'; reset_local error 'CSRF token 为空'; return 1; }
    printf %s "$csrf" > "$CSRF_FILE"
    chmod 600 "$COOKIE" "$CSRF_FILE"

    body=$(curl_bound 15 -b "$COOKIE" -H "X-CSRF-Token: $csrf" -H 'X-Requested-With: XMLHttpRequest' \
        -H 'Content-Type: application/x-www-form-urlencoded' --data-urlencode "nasId=$(get nas_id)" \
        --data-urlencode "userIpv4=$IP" --data-urlencode "userMac=$MAC" \
        --data-urlencode "username=$(get username)" --data-urlencode "password=$(get password)" \
        "$url/api/account/check" || true)
    code=$(printf %s "$body" | jsonfilter -e '@.code' 2>/dev/null || true)
    if [ "$code" != 0 ]; then
        msg=$(response_message "$body" || true)
        [ -n "$msg" ] || msg='账号检查失败'
        err "账号检查失败: $msg"
        reset_local error "$msg"
        return 1
    fi

    body=$(curl_bound 20 -b "$COOKIE" -H "X-CSRF-Token: $csrf" -H 'X-Requested-With: XMLHttpRequest' \
        -H 'Content-Type: application/x-www-form-urlencoded' --data-urlencode "nasId=$(get nas_id)" \
        --data-urlencode "userIpv4=$IP" --data-urlencode "userMac=$MAC" \
        --data-urlencode "username=$(get username)" --data-urlencode "password=$(get password)" \
        "$url/api/account/login" || true)
    code=$(printf %s "$body" | jsonfilter -e '@.code' 2>/dev/null || true)
    auth=$(printf %s "$body" | jsonfilter -e '@.authCode' 2>/dev/null || true)
    dial=$(printf %s "$body" | jsonfilter -e '@.dialCode' 2>/dev/null || true)
    if [ "$code" != 0 ] || { [ -n "$auth" ] && ! printf %s "$auth" | grep -qi '^ok:'; } || printf %s "$dial" | grep -q '^E'; then
        msg=$(response_message "$body" || true)
        [ -n "$msg" ] || msg='认证未成功'
        err "登录失败: $msg"
        reset_local error "$msg"
        return 1
    fi

    if ! identity_matches "$body"; then
        err '服务端返回的账号、IPv4、MAC 或 SessionId 与本实例不符；拒绝接管该会话'
        reset_local identity_mismatch '服务端返回了其他网络身份，已拒绝接管'
        return 1
    fi

    isp=$(printf %s "$body" | jsonfilter -e '@.isp' 2>/dev/null || true)
    printf %s "$isp" > "$ISP_FILE"
    printf %s "$RESPONSE_SESSION" > "$SESSION_FILE"
    chmod 600 "$ISP_FILE" "$SESSION_FILE"
    OPERATOR=$isp
    DIAL_CODE=$dial
    LAST_MESSAGE='认证成功'
    ACTIVE=1
    OWNED=1
    write_status online
    log "登录成功 interface=$(get interface) device=$DEVICE ip=$IP role=$(get role)"
}

session_ok() {
    local body code dial previous_session
    [ "$ACTIVE" -eq 1 ] && [ "$OWNED" -eq 1 ] || return 1
    body=$(curl_bound 10 -b "$COOKIE" "$(portal)/api/account/status?nasId=$(get nas_id)&userIpv4=$IP&userMac=$MAC&username=$(get username)&isp=$(cat "$ISP_FILE" 2>/dev/null || true)" || true)
    code=$(printf %s "$body" | jsonfilter -e '@.code' 2>/dev/null || true)
    dial=$(printf %s "$body" | jsonfilter -e '@.dialCode' 2>/dev/null || true)
    [ "$code" = 0 ] && ! printf %s "$dial" | grep -q '^E' && identity_matches "$body" || return 1
    previous_session=$(cat "$SESSION_FILE" 2>/dev/null || true)
    [ -z "$previous_session" ] || [ "$RESPONSE_SESSION" = "$previous_session" ] || log '服务端 SessionId 已更新'
    printf %s "$RESPONSE_SESSION" > "$SESSION_FILE"
    chmod 600 "$SESSION_FILE"
}

mkdir -p "$BASE"
chmod 700 "$BASE"
stale_policy_clear || exit 1
trap 'exit 0' INT TERM
trap cleanup EXIT
write_status starting

while :; do
    if [ -f "$BASE/reauth" ]; then
        rm -f "$BASE/reauth"
        if [ "$OWNED" -eq 1 ]; then
            logout
        else
            reset_local authenticating '收到重新认证请求'
        fi
    fi
    if network_info; then
        if ! claim_identity; then
            reset_local identity_conflict
            sleep 30
            continue
        fi
        if ! policy_route_setup; then
            err '无法建立源地址策略路由'
            reset_local error '无法建立源地址策略路由'
            sleep 30
            continue
        fi
        if [ "$ACTIVE" -eq 1 ]; then
            if ! session_ok; then
                err '认证状态无效或返回身份不匹配，丢弃本地会话并重新登录'
                reset_local identity_mismatch '认证状态无效或返回身份不匹配'
                authenticate || true
            fi
        else
            authenticate || true
        fi
    else
        policy_route_clear
        release_identity_lock
        [ "$ACTIVE" -eq 0 ] || reset_local waiting '所选接口暂时没有 IPv4 地址'
        LAST_MESSAGE='等待所选接口获取 IPv4 地址'
        write_status waiting
        log "等待实例 $SECTION 所选接口获取 IPv4 地址"
    fi
    sleep 30
done
